<Page
    x:Class="Markdown.MarkdownToExcel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:common="using:Syncfusion.DemosCommon.WinUI"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="200"
    d:DesignWidth="800"
    mc:Ignorable="d"
    >
    <StackPanel>
        <common:DemoLayout 
        HeaderText="This sample demonstrates how to convert a Markdown file to an Excel worksheet using .NET Excel (XlsIO) and .NET Markdown libraries."
        CSharpSource="{common:ConditionalXAML Individual=Syncfusion.MarkdownDemos.WinUI/Assets/Markdown/MarkdownToExcel_cs.txt,
                                                         Common=Markdown/Assets/Markdown/MarkdownToExcel_cs.txt}">
            <common:DemoLayout.Example>
                <ContentControl>
                    <Grid x:Name="Conversions" Margin="5,0,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="textBlock5" Grid.Row="5" Grid.ColumnSpan="4"/>
                        <TextBlock x:Name="textBlock6" Grid.Row="6" Grid.ColumnSpan="4" TextWrapping="Wrap" Text="Click the &quot;View Input Template&quot; button to view the input Markdown document. Please note that a Markdown-compatible viewer is required to open and view the Markdown document."/>
                        <TextBlock x:Name="textBlock7" Grid.Row="7" Grid.ColumnSpan="4" TextWrapping="Wrap" Text="Click the &quot;Convert To Excel&quot; button to view the converted Excel file. Please note that an Excel-compatible viewer is required to open and view the Excel document." Padding="0,10,0,0" />
                        <TextBlock x:Name="textBlock8" Grid.Row="8" Grid.ColumnSpan="4"/>
                        <Button x:Name="btnInput" Grid.Row="11" Grid.ColumnSpan="1" Content="View Input Template" HorizontalAlignment="Left" Click="btnInput_Click" Height="Auto" Width="160" Padding="10,10,10,10" Margin="0,10" />
                        <Button x:Name="btnConvert" Grid.Row="11" Grid.ColumnSpan="2" Content="Convert To Excel" HorizontalAlignment="Left" Click="btnConvert_Click" VerticalAlignment="Top" Height="Auto" Width="160" Padding="10,10,10,10" Margin="170,10,0,0" />
                    </Grid>
                </ContentControl>
            </common:DemoLayout.Example>
        </common:DemoLayout>
    </StackPanel>
</Page>