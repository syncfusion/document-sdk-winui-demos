<Page
    x:Class="Syncfusion.PdfDemos.WinUI.LinearizedPdf"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:common="using:Syncfusion.DemosCommon.WinUI"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Background="Transparent"
    mc:Ignorable="d">
    <StackPanel>
        <common:DemoLayout 
                HeaderText="This sample demonstrates how to convert an existing PDF document into a linearized PDF for faster web viewing."
                CSharpSource="{common:ConditionalXAML Individual=Syncfusion.PdfDemos.WinUI/Assets/Pdf/LinearizedPDF_xaml_cs.txt,
                                                                 Common=Pdf/Assets/Pdf/LinearizedPDF_xaml_cs.txt}">
            <common:DemoLayout.Example>
                <Grid x:Name="grdMain" Margin="10,10,10,10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"></RowDefinition>
                        <RowDefinition Height="Auto"></RowDefinition>
                        <RowDefinition Height="Auto"></RowDefinition>
                        <RowDefinition Height="Auto"></RowDefinition>
                        <RowDefinition Height="Auto"></RowDefinition>
                        <RowDefinition Height="Auto"></RowDefinition>
                        <RowDefinition Height="Auto"></RowDefinition>
                        <RowDefinition Height="Auto"></RowDefinition>
                        <RowDefinition Height="Auto"></RowDefinition>
                        <RowDefinition Height="Auto"></RowDefinition>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"></ColumnDefinition>
                        <ColumnDefinition Width="50"></ColumnDefinition>
                    </Grid.ColumnDefinitions>
                    <TextBlock TextWrapping="Wrap" Padding="0,5,0,0" Grid.Row="1" Grid.ColumnSpan="3" Text="Click the button to create and view the linearized PDF document generated by Syncfusion PDF library." />
                    <TextBlock Text="Choose a PDF file for linearization" Grid.Row="3" Grid.Column="0" Margin="0,10,0,0" VerticalAlignment="Center" />
                    <TextBox x:Name="SourcePdf" Text="pdf_succinctly.pdf" Grid.Row="4" Grid.Column="0" Margin="0,0,8,0" Padding="8" Height="40" IsReadOnly="True" HorizontalAlignment="Stretch" />
                    <Button Content="..." Grid.Row="4" Grid.Column="1" Margin="0,0,0,0" Padding="0" Width="42" Height="40" HorizontalAlignment="Right" Click="ChooseFile_Click" />
                    <Button Content="Convert to Linearized PDF" Grid.Row="8" Grid.Column="0" Margin="0,14,0,0" Padding="20,8" Height="40" HorizontalAlignment="Left" VerticalAlignment="Top" Click="Button_Click"/>
                </Grid>
            </common:DemoLayout.Example>
        </common:DemoLayout>
    </StackPanel>
</Page>
